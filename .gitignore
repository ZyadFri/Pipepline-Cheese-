# ── Secrets & environment ──────────────────────────────────────────
.env
.env.local
.env.production
backend/.env
backend/*.env

# ── Databases (never commit — contains user research data) ─────────
*.db
*.sqlite
*.sqlite3
backend/food_research.db
backend/test.db

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
backend/venv/
backend/.venv/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/htmlcov/
backend/.coverage

# ── Uploads (user research PDFs — never commit) ───────────────────
backend/uploads/

# ── Generated exports (regeneratable dataset/report output) ────────
backend/exports/

# ── Node / Frontend ────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.vercel/
node_modules/

# ── Logs ───────────────────────────────────────────────────────────
*.log
logs/
celery*.log
worker.log

# ── OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Stray backup archives (not source, not meant to be tracked) ────
backend/app.zip
frontend/src.zip

# ── Local-only source assets (originals for derived, already-tracked ───
# images under frontend/public/ — kept on disk for provenance, not git) ─
docs/assets/

# ── Demo recording intermediates (regeneratable via the record_* scripts;
# only the 1080p presentation MP4s + notes are tracked — 4K is a large
# upscale produced locally by render_demos.sh, not committed) ──────────
docs/demo/presentation/raw_video1/
docs/demo/presentation/raw_video2/
docs/demo/presentation/video1_timing.json
docs/demo/presentation/video2_timing.json
docs/demo/presentation/qc_*.png
docs/demo/presentation/continuity_*.png
docs/demo/presentation/*_4k.mp4
