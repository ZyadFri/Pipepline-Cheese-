# Copy to .env and fill in values. NEVER commit .env to version control.

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
DATABASE_URL=sqlite:///./food_research.db
# PostgreSQL: DATABASE_URL=postgresql://user:pass@host:5432/food_research

# ============================================================
# AI Provider — set AI_PROVIDER to ONE of: groq, vertexai, google_ai, openai, anthropic
# ============================================================
AI_PROVIDER=groq

# OPTION A — Groq (recommended quick start; also what production uses)
#   Get a free key at: console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=groq/compound
GROQ_FOOD_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# OPTION B — Google AI Studio (easiest Google option, free key, no IAM needed)
#   Get key at: aistudio.google.com -> Get API key
#   Set AI_PROVIDER=google_ai and fill in GOOGLE_API_KEY
GOOGLE_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# OPTION C — Vertex AI (ADC — requires GCP project access, not needed for local dev)
#   Requires: gcloud auth application-default login, and the "Vertex AI User"
#   IAM role on VERTEX_PROJECT for the authenticated account
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# OPTION D — OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OPTION E — Anthropic
ANTHROPIC_API_KEY=

AI_MAX_TOKENS=16384

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=50
MAX_PAPERS_PER_UPLOAD=10
UPLOAD_DIR=uploads
